# Clerk — use test keys locally and in Preview, live keys only in Production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional dedicated signing material for newly issued TGPI Global Keys.
# Use at least 32 random bytes and keep it server-only. Existing keys retain
# their original cryptographic slot so adding this later does not rewrite them.
TGPI_GLOBAL_KEY_SECRET=

# Canonical application URL. Use the deployment URL in Preview and the official
# TGPI domain in Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — never expose the secret key or webhook secret to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Keep false until the complete Stripe test flow has passed.
BILLING_ENABLED=false

# Preview-only founder/test access. Comma-separate Clerk User IDs. The server
# ignores this value unless VERCEL_ENV=preview and the request host is *.vercel.app.
TGPI_PREMIUM_PREVIEW_USER_IDS=

# Production-only Founder Access. Comma-separate approved Clerk User IDs. The
# server accepts this value only on the official TGPI domains in Production.
TGPI_FOUNDER_USER_IDS=

# Optional production-only fallback for Clerk instances that assign different
# User IDs. Access requires an exact match with a verified primary email.
TGPI_FOUNDER_EMAILS=
